# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/polar_hub

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage
STORAGE_BUCKET=polar-knowledge-hub
STORAGE_URL=https://your-project.supabase.co/storage/v1

# Redis (optional for celery)
REDIS_URL=redis://localhost:6379

# App settings
APP_NAME=Polar Knowledge Hub
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Crawler settings
CRAWLER_USER_AGENT=PolarKnowledgeHub/1.0 (SIH2026; Educational Research)
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=100
CRAWLER_DELAY_SECONDS=2
CRAWLER_ALLOWED_DOMAINS=ncpor.res.in,ncaor.gov.in

# Demo mode
DEMO_MODE=false
